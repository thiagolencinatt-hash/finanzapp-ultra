# ==============================================================================
# FinanzApp Ultra — Variables de Entorno para Despliegue en la Nube
# ==============================================================================

# URL de la aplicación en producción (Ej: https://tu-proyecto.vercel.app)
NEXT_PUBLIC_APP_URL=https://localhost:3000

# Google Gemini API Key (Para el Asistente Financiero IA y lectura de comprobantes)
GEMINI_API_KEY=

# Supabase (Opcional - La app funciona con persistencia nativa multi-tenant en la nube)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend API (Opcional - Para envío de códigos de verificación por email)
RESEND_API_KEY=
